{
  "name": "agent-cron",
  "version": "0.6.0",
  "description": "Cron-driven scheduled prompt tasks, each run in an isolated agent session",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "scheduler",
    "cron",
    "task-scheduler",
    "automation"
  ],
  "author": "fookhsu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fookhsu/agent-cron.git"
  },
  "homepage": "https://github.com/fookhsu/agent-cron#readme",
  "bugs": {
    "url": "https://github.com/fookhsu/agent-cron/issues"
  },
  "type": "module",
  "bin": {
    "agent-cron": "./bin/agent-cron.mjs"
  },
  "files": [
    "assets",
    "bin",
    "skills",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepublishOnly": "npm run check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "croner": "^9.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.30",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/agents/pi/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
