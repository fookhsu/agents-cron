{
  "name": "agents-cron",
  "version": "0.14.0",
  "description": "Cron-driven scheduled prompt tasks, each run in an isolated agent session",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "scheduler",
    "cron",
    "task-scheduler",
    "automation"
  ],
  "author": "fookhsu",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fookhsu/agents-cron.git"
  },
  "homepage": "https://github.com/fookhsu/agents-cron#readme",
  "bugs": {
    "url": "https://github.com/fookhsu/agents-cron/issues"
  },
  "type": "module",
  "bin": {
    "agents-cron": "bin/agents-cron.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "assets",
    "bin",
    "index.mjs",
    "skills",
    "src"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepublishOnly": "npm run check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "croner": "^9.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.30",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/fookhsu/agents-cron/main/assets/dashboard.png",
    "extensions": [
      "./index.mjs"
    ],
    "skills": [
      "./skills"
    ]
  },
  "optionalDependencies": {
    "nodemailer": "^10.1.6"
  }
}
